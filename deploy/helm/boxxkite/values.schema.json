{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "boxxkite chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "controlPlaneServiceAccountName", "sandboxConfig", "storageCredentials", "resources", "volumeSizeLimits", "networkPolicy", "podSecurityPolicy", "imageBuilder"],
  "properties": {
    "namespace": {"type": "string", "minLength": 1},
    "controlPlaneServiceAccountName": {"type": "string", "minLength": 1},
    "sandboxConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["s3Bucket", "awsRegion", "warmPoolSize", "podTimeoutSeconds"],
      "properties": {
        "s3Bucket": {"type": "string"}, "awsRegion": {"type": "string"},
        "warmPoolSize": {"type": "integer", "minimum": 0},
        "podTimeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "storageCredentials": {
      "type": "object", "additionalProperties": false,
      "required": ["manage", "accessKeyId", "secretAccessKey"],
      "properties": {
        "manage": {"type": "boolean"}, "accessKeyId": {"type": "string"}, "secretAccessKey": {"type": "string"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["sandboxContainer", "sidecarContainer"],
      "properties": {
        "sandboxContainer": {"$ref": "#/definitions/resourceValues"},
        "sidecarContainer": {"$ref": "#/definitions/resourceValues"}
      }
    },
    "volumeSizeLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "uploads", "outputs", "skills", "tmp"],
      "properties": {
        "workspace": {"type": "string"}, "uploads": {"type": "string"}, "outputs": {"type": "string"},
        "skills": {"type": "string"}, "tmp": {"type": "string"}
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "ingressFromPodLabels", "storageEgress", "gitEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFromPodLabels": {"type": "array", "items": {"$ref": "#/definitions/stringMap"}},
        "storageEgress": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "inCluster", "ipBlock", "fqdn"],
          "properties": {
            "mode": {"type": "string", "enum": ["none", "inCluster", "ipBlock", "fqdn"]},
            "inCluster": {
              "type": "object", "additionalProperties": false,
              "required": ["namespace", "podLabels", "port"],
              "properties": {"namespace": {"type": "string", "minLength": 1}, "podLabels": {"$ref": "#/definitions/stringMap"}, "port": {"$ref": "#/definitions/port"}}
            },
            "ipBlock": {
              "type": "object", "additionalProperties": false,
              "required": ["cidr", "port"],
              "properties": {"cidr": {"$ref": "#/definitions/cidr"}, "port": {"$ref": "#/definitions/port"}}
            },
            "fqdn": {
              "type": "object", "additionalProperties": false,
              "required": ["fqdnEgressSupported", "patterns", "port"],
              "properties": {"fqdnEgressSupported": {"type": "boolean"}, "patterns": {"type": "array", "items": {"type": "string", "minLength": 1}}, "port": {"$ref": "#/definitions/port"}}
            }
          }
        },
        "gitEgress": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "hosts", "port", "sshPort"],
          "properties": {"enabled": {"type": "boolean"}, "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}}, "port": {"$ref": "#/definitions/port"}, "sshPort": {"$ref": "#/definitions/port"}}
        }
      }
    },
    "podSecurityPolicy": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "imageBuilder": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "serviceAccountName", "networkPolicy"],
      "properties": {
        "enabled": {"type": "boolean"}, "serviceAccountName": {"type": "string", "minLength": 1},
        "networkPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["packageRegistryCidr", "registryCidr"],
          "properties": {"packageRegistryCidr": {"$ref": "#/definitions/cidr"}, "registryCidr": {"$ref": "#/definitions/cidr"}}
        }
      }
    }
  },
  "definitions": {
    "resourceValues": {
      "type": "object", "additionalProperties": false,
      "required": ["cpuRequest", "memoryRequest", "cpuLimit", "memoryLimit"],
      "properties": {"cpuRequest": {"type": "string"}, "memoryRequest": {"type": "string"}, "cpuLimit": {"type": "string"}, "memoryLimit": {"type": "string"}}
    },
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "cidr": {
      "type": "string",
      "description": "IPv4, IPv6, or IPv4-embedded IPv6 CIDR syntax screening only; this does not exhaustively validate CIDR semantics.",
      "pattern": "^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])|(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:((:[0-9A-Fa-f]{1,4}){1,6})|:((:[0-9A-Fa-f]{1,4}){1,7}|:)|([0-9A-Fa-f]{1,4}:){6}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|::([0-9A-Fa-f]{1,4}:){0,4}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9A-Fa-f]{1,4}::([0-9A-Fa-f]{1,4}:){0,3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|([0-9A-Fa-f]{1,4}:){1}[0-9A-Fa-f]{1,4}::([0-9A-Fa-f]{1,4}:){0,2}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|([0-9A-Fa-f]{1,4}:){2}[0-9A-Fa-f]{1,4}::([0-9A-Fa-f]{1,4}:){0,1}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|([0-9A-Fa-f]{1,4}:){3}[0-9A-Fa-f]{1,4}::(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|([0-9A-Fa-f]{1,4}:){4}[0-9A-Fa-f]{1,4}::(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$"
    }
  }
}
